#!/usr/bin/env bash
# Every local gate in one script (docs/PLAN.md §3, §12). Agents and the owner run this before a
# change is committed. It stops at the first failing step with a non-zero exit.
#
#   script/check               steps 1-6
#   script/check --fast        steps 1-5 (skips the e2e scenarios)
#   script/check --e2e-only    step 6 alone
set -euo pipefail

usage() {
    cat <<'EOF'
usage: script/check [--fast | --e2e-only]

  1. cargo fmt --all --check
  2. cargo clippy in scrollback's two shapes: default (with automation) and the shipped app
     (-p scrollback --no-default-features)
  3. gpui boundary: no gpui in the headless crates' dependency trees
  4. agent names: no agent is named in sb_core outside its provider, nor anywhere in sb_ui,
     in a file's contents or in its path
  5. cargo test --workspace
  6. e2e scenarios in tests/e2e through sb_e2e (background)   skipped with --fast
     (--e2e-only: this step alone)
EOF
}

fast=0
e2e_only=0
for arg in "$@"; do
    case "$arg" in
        --fast) fast=1 ;;
        --e2e-only) e2e_only=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "script/check: unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ "$fast" -eq 1 && "$e2e_only" -eq 1 ]]; then
    echo "script/check: --e2e-only is step 6 alone, which --fast skips" >&2
    exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

step() {
    printf '\n==> [%s] %s\n' "$1" "$2"
}

# The crates that must never depend on gpui, even transitively (PLAN §3).
headless_crates=(sb_core sb_test_support sb_e2e)

# The agents scrollback has a provider for, one entry each: the agent's name as one lowercase
# word, then its provider's module. An agent may be named only in its provider,
# crates/sb_core/src/provider/<module>, a file or a folder (PLAN D8, §12). Adding an agent is
# adding an entry.
agents=(claude:claude_code)
# Where no agent may be named, in a file's contents or in a path.
agent_scope=(crates/sb_core crates/sb_ui)
# The one file outside the providers that has to refer to them: it declares each provider's
# module and lists the providers. There, a line may name an agent only as its module's
# identifier (`mod <module>;`, `<module>::…`).
provider_list=crates/sb_core/src/provider/mod.rs

# An extended regex for the agent name $1 as a whole word or as one word of an identifier, in the
# casings identifiers use: `name`, `name_x`, `x-name`, `nameX`; `Name`, `NameX`, `xName`;
# `NAME`, `NAME_X`. A name inside a longer word doesn't match, so a short name is safe to add.
agent_pattern() {
    local lower="$1" upper capital
    upper="$(printf '%s' "$lower" | tr '[:lower:]' '[:upper:]')"
    capital="$(printf '%s' "${lower:0:1}" | tr '[:lower:]' '[:upper:]')${lower:1}"
    printf '(^|[^A-Za-z])%s($|[^a-z])|(^|[^A-Z])%s($|[^a-z])|(^|[^A-Za-z])%s($|[^A-Za-z])' \
        "$lower" "$capital" "$upper"
}

# Filters `grep -n` lines on stdin: drops those from $provider_list in which the pattern $1
# matches nothing once the module identifier $2 is taken out.
drop_module_identifier_lines() {
    local pattern="$1" strip="s/(^|[^A-Za-z0-9_])$2(\$|[^A-Za-z0-9_])/\\1\\2/g" line text
    while IFS= read -r line; do
        if [[ "$line" == "$provider_list":* ]]; then
            text="${line#"$provider_list":*:}"
            # Twice: two identifiers one character apart share that character.
            if ! printf '%s\n' "$text" | sed -E -e "$strip" -e "$strip" | grep -qE -e "$pattern"; then
                continue
            fi
        fi
        printf '%s\n' "$line"
    done
}

if [[ "$e2e_only" -eq 0 ]]; then
    step 1 "cargo fmt --all --check"
    cargo fmt --all --check

    # scrollback's two shapes: each drifts silently unless it is linted on its own.
    step 2 "cargo clippy --workspace --all-targets -- -D warnings  (scrollback with automation)"
    cargo clippy --workspace --all-targets -- -D warnings
    step 2 "cargo clippy -p scrollback --no-default-features --all-targets -- -D warnings  (the shipped app)"
    cargo clippy -p scrollback --no-default-features --all-targets -- -D warnings

    step 3 "gpui boundary: ${headless_crates[*]}"
    boundary_ok=1
    for crate in "${headless_crates[@]}"; do
        # Normal dependencies only (dev-dependencies may use gpui's test support), every target
        # platform, one crate per line without tree drawing.
        tree="$(cargo tree -p "$crate" --all-features -e normal --target all --prefix none)"
        # gpui's own crates (gpui-pre*, gpui-component, gpui-base, gpui-kit-assets) are
        # hyphenated; toolbox-rs's gpui-free automation crates (gpui_automation_runner,
        # …_protocol) are not.
        offenders="$(printf '%s\n' "$tree" | grep -E '^gpui-' | sed 's/ (\*)$//' | sort -u || true)"
        if [[ -n "$offenders" ]]; then
            boundary_ok=0
            echo "error: $crate depends on gpui:" >&2
            printf '%s\n' "$offenders" | sed 's/^/  /' >&2
            echo "  (cargo tree -p $crate --all-features -e normal --target all -i <name> shows the path to one)" >&2
        else
            echo "ok: $crate"
        fi
    done
    if [[ "$boundary_ok" -ne 1 ]]; then
        exit 1
    fi

    step 4 "agent names: each only in crates/sb_core/src/provider/<its module>"
    agents_ok=1
    for agent in "${agents[@]}"; do
        name="${agent%%:*}"
        module="${agent#*:}"
        provider="crates/sb_core/src/provider/$module"
        pattern="$(agent_pattern "$name")"
        # Every line naming the agent, less the provider's own file or folder and the module
        # identifier in the provider list; then every path naming it, less the provider's own.
        offenders="$(grep -rInE -e "$pattern" "${agent_scope[@]}" |
            grep -v -e "^$provider\.rs:" -e "^$provider/" |
            drop_module_identifier_lines "$pattern" "$module" || true)"
        paths="$(find "${agent_scope[@]}" | grep -E -e "$pattern" |
            grep -v -E -e "^$provider(\.rs|/.*)?\$" || true)"
        if [[ -n "$offenders" || -n "$paths" ]]; then
            agents_ok=0
            echo "error: \"$name\" is named outside $provider:" >&2
            printf '%s\n' "$offenders" "$paths" | sed -e '/^$/d' -e 's/^/  /' >&2
        else
            echo "ok: $name"
        fi
    done
    if [[ "$agents_ok" -ne 1 ]]; then
        echo "  everything specific to an agent lives in its provider; views show its display" >&2
        echo "  name and mark from there (PLAN D8, §7.6, §11)" >&2
        exit 1
    fi

    step 5 "cargo test --workspace"
    cargo test --workspace
fi

if [[ "$fast" -eq 1 ]]; then
    step 6 "e2e scenarios: skipped (--fast)"
else
    # An all-targets build (and `cargo test`, once a bin crate has integration tests) can relink
    # the binary with gpui's test support (leak detection and other test-only machinery), so the
    # runner gets a freshly built plain one right before it starts it; the runner itself never
    # builds anything.
    step 6 "cargo build -p scrollback  (a plain binary for the runner)"
    cargo build -p scrollback
    step 6 "e2e scenarios: cargo run -p sb_e2e --bin e2e -- tests/e2e"
    cargo run -p sb_e2e --bin e2e -- tests/e2e
fi

printf '\nscript/check: all steps passed\n'
