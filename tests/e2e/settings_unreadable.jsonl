{"scenario": {"window_size": "1440x900", "fixture": "settings-unreadable", "description": "A settings file that can't be read (DESIGN §4.14): it names an archive, but isn't JSON, so nothing is opened or made, the file is left as it is, and the page says why and offers the default archive or another folder; choosing the default opens it, and the file is written from then on"}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "settle", "expect": [{"pointer": "/page", "equals": "archive-failed"}, {"pointer": "/archive/failure", "equals": "settings"}, {"pointer": "/archive/error", "contains": "isn't a JSON object"}, {"pointer": "/sync/locations", "equals": []}]}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}

// No Try again, no Locate: the owner's choice of an archive settles it.
{"cmd": "bounds", "target": "archive/use-default", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "archive/use-folder", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "archive/retry", "expect_error": "no target"}
{"cmd": "bounds", "target": "archive/locate", "expect_error": "no target"}
{"cmd": "screenshot", "name": "settings-unreadable-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "settings-unreadable-light"}

// A restart reads the same file, untouched: still nothing opened.
{"restart": {}}
{"cmd": "settle", "expect": [{"pointer": "/page", "equals": "archive-failed"}, {"pointer": "/archive/failure", "equals": "settings"}]}

// Use the default archive: one is made in the data folder, and the app opens at its first run.
{"cmd": "click", "target": "archive/use-default"}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/page", "equals": "first-run"}, {"pointer": "/archive/state", "equals": "open"}, {"pointer": "/settings/default", "equals": true}]}
{"restart": {}}
{"cmd": "settle", "expect": [{"pointer": "/page", "equals": "first-run"}, {"pointer": "/archive/state", "equals": "open"}]}
