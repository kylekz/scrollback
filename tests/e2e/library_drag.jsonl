{"scenario": {"window_size": "1440x900", "fixture": "boards", "description": "Drag and drop in the library (DESIGN §4.1, §4.4, §4.6), on the boards' library: a card onto a sidebar folder, filed by hand with a toast that undoes it; several cards selected and dragged together; Esc giving a drag up; a card onto Trash; Unsorted's path chip onto a folder, attaching the path; a folder's path chip onto its own folder, refused; and folders nested and reordered in the tree. Each ghost and drop target is captured mid-drag, dark and light"}}
{"cmd": "wait_ready", "timeout_ms": 30000}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/library/sessions", "equals": 2318}]}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}
{"cmd": "click", "target": "sidebar/folder/fc"}
{"cmd": "settle", "expect": {"pointer": "/library/shelf", "equals": {"folder": "fc"}}}

// A card dragged onto dv: it stays in place dashed and dimmed, dv takes the drop-target style, and the ghost says where it goes and what that does (E-Folder).
{"cmd": "drag", "from": {"target": "card/2"}, "to": {"target": "sidebar/folder/dv"}, "release": false}
{"cmd": "state", "expect": [{"pointer": "/library/drag/what", "equals": {"sessions": 1}}, {"pointer": "/library/drag/moved", "equals": true}, {"pointer": "/library/drag/over", "equals": {"folder": "dv"}}, {"pointer": "/library/drag/verdict", "equals": {"takes": true, "result": "dv", "note": "files by hand"}}]}
{"cmd": "screenshot", "name": "card-onto-folder-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "wait_frames", "n": 2}
{"cmd": "screenshot", "name": "card-onto-folder-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": [{"pointer": "/library/drag", "equals": null}, {"pointer": "/library/toast", "equals": {"text": "Filed in dv by hand", "undo": true}}, {"pointer": "/library/folders/0/sessions", "equals": 613}, {"pointer": "/library/sessions", "equals": 487}]}
{"cmd": "screenshot", "name": "filed-toast-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "wait_frames", "n": 2}
{"cmd": "screenshot", "name": "filed-toast-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
// Undo puts it back where the rules had it, and says so in a toast with no Undo of its own, dismissed.
{"cmd": "click", "target": "toast/undo"}
{"cmd": "settle", "expect": [{"pointer": "/library/toast", "equals": {"text": "Undone", "undo": false}}, {"pointer": "/library/folders/0/sessions", "equals": 612}, {"pointer": "/library/sessions", "equals": 488}]}
{"cmd": "click", "target": "toast/dismiss"}
{"cmd": "settle", "expect": {"pointer": "/library/toast", "equals": null}}

// Ctrl-click selects a second card; a drag of either carries both, and the ghost reads "2 sessions". Esc gives it up.
{"cmd": "click", "target": "card/0"}
{"cmd": "click", "target": "card/1", "modifiers": "secondary"}
{"cmd": "state", "expect": {"pointer": "/library/selection", "len": 2}}
{"cmd": "drag", "from": {"target": "card/1"}, "to": {"target": "sidebar/folder/folio"}, "release": false}
{"cmd": "state", "expect": [{"pointer": "/library/drag/what", "equals": {"sessions": 2}}, {"pointer": "/library/drag/verdict/takes", "equals": true}]}
{"cmd": "screenshot", "name": "two-sessions-dark"}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/library/drag", "equals": null}}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": [{"pointer": "/library/sessions", "equals": 488}, {"pointer": "/library/toast", "equals": null}]}

// Onto Trash: both go, with a toast that brings them back.
{"cmd": "drag", "from": {"target": "card/0"}, "to": {"target": "sidebar/trash"}, "release": false}
{"cmd": "state", "expect": [{"pointer": "/library/drag/over", "equals": "trash"}, {"pointer": "/library/drag/verdict", "equals": {"takes": true, "result": "Trash", "note": "moves to Trash"}}]}
{"cmd": "screenshot", "name": "onto-trash-dark"}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": [{"pointer": "/library/sessions", "equals": 486}, {"pointer": "/library/toast/text", "equals": "2 sessions moved to Trash"}]}
{"cmd": "click", "target": "toast/undo"}
{"cmd": "settle", "expect": [{"pointer": "/library/sessions", "equals": 488}, {"pointer": "/library/toast/text", "equals": "Undone"}]}
{"cmd": "click", "target": "toast/dismiss"}
{"cmd": "settle", "expect": {"pointer": "/library/toast", "equals": null}}

// A path chip of fc onto fc itself: refused, no target shows, and the ghost says why.
{"cmd": "drag", "from": {"target": "page/path/1"}, "to": {"target": "sidebar/folder/fc"}, "release": false}
{"cmd": "state", "expect": [{"pointer": "/library/drag/what", "equals": {"path": "/home/user/code/fc"}}, {"pointer": "/library/drag/verdict", "equals": {"takes": false, "note": "already attached to fc"}}]}
{"cmd": "screenshot", "name": "path-refused-dark"}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": {"pointer": "/library/toast", "equals": null}}

// Unsorted (E-Unsorted): the chip of /home/user/code/scrollback-spike onto scrollback attaches it there, limited to its location, and files its sessions.
{"cmd": "click", "target": "sidebar/unsorted"}
{"cmd": "settle", "expect": {"pointer": "/page", "equals": "unsorted"}}
{"cmd": "click", "target": "unsorted/filter/field"}
{"cmd": "type", "text": "scrollback-spike"}
{"cmd": "settle"}
{"cmd": "query", "prefix": "unsorted/group/", "expect_result": {"pointer": "/0/target", "contains": "unsorted/group/"}, "save": {"spike": "/0/target"}}
{"cmd": "drag", "from": {"target": "${spike}/chip"}, "to": {"target": "sidebar/folder/scrollback"}, "release": false}
{"cmd": "state", "expect": [{"pointer": "/library/drag/what", "equals": {"path": "/home/user/code/scrollback-spike"}}, {"pointer": "/library/drag/verdict", "equals": {"takes": true, "result": "attach to scrollback", "note": "files 3 sessions"}}]}
{"cmd": "screenshot", "name": "chip-onto-folder-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "wait_frames", "n": 2}
{"cmd": "screenshot", "name": "chip-onto-folder-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": [{"pointer": "/library/toast/text", "equals": "Attached to scrollback · 3 sessions filed"}, {"pointer": "/library/counts/unsorted", "equals": 34}]}
{"cmd": "click", "target": "toast/undo"}
{"cmd": "settle", "expect": {"pointer": "/library/counts/unsorted", "equals": 37}}

// The folder tree: slide dropped on folio nests it; then above dv's row, between the top of the tree and dv, it moves back to the top, the 2px insertion line showing where.
{"cmd": "drag", "from": {"target": "sidebar/folder/slide"}, "to": {"target": "sidebar/folder/folio"}, "release": false}
{"cmd": "state", "expect": {"pointer": "/library/drag/verdict", "equals": {"takes": true, "result": "folio", "note": "nests it"}}}
{"cmd": "screenshot", "name": "folder-into-folder-dark"}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": {"pointer": "/library/folders", "contains": {"name": "slide", "parent": "folio"}}}
{"cmd": "click", "target": "sidebar/folder-chevron/folio"}
{"cmd": "drag", "from": {"target": "sidebar/folder/slide"}, "to": {"target": "sidebar/folder/dv", "dy": -14}, "release": false}
{"cmd": "state", "expect": [{"pointer": "/library/drag/over", "equals": {"between": {"parent": null, "index": 0}}}, {"pointer": "/library/drag/verdict", "equals": {"takes": true, "result": "the top", "note": "moves it here"}}]}
{"cmd": "bounds", "target": "sidebar/insertion", "expect_result": [{"pointer": "/h", "equals": 2}, {"pointer": "/visible", "not_equals": null}]}
{"cmd": "screenshot", "name": "folder-between-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "wait_frames", "n": 2}
{"cmd": "screenshot", "name": "folder-between-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
{"cmd": "mouse_up"}
{"cmd": "settle", "expect": [{"pointer": "/library/folders/0", "equals": {"name": "slide", "parent": null, "sessions": 197}}]}
