{"scenario": {"window_size": "1440x900", "fixture": "boards", "description": "The library the design boards draw (DESIGN §6: E-Folder, E-All-Sessions, E-Unsorted), from an archive built before the app starts: the sidebar's counts and folder tree, a folder's page with its path chips and cards, All sessions, Starred and Unsorted, each captured dark and light at the boards' size and at the minimum window size, with the keyboard moving between rows and cards"}}
{"cmd": "wait_ready", "timeout_ms": 30000}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/archive/state", "equals": "open"}, {"pointer": "/library/shelf", "equals": "all"}, {"pointer": "/library/counts", "equals": {"all": 2318, "starred": 14, "unsorted": 37}}, {"pointer": "/library/sessions", "equals": 2318}, {"pointer": "/library/folders", "len": 10}, {"pointer": "/sync/locations", "len": 3}, {"pointer": "/sync/syncing", "equals": false}]}
// One location of each kind. Their agents are not on this machine, so the start's sync finds nothing to copy and nothing to mark gone; a scripted run reaches no host, so the one over SSH is unreachable, which is no failure and has no banner.
{"cmd": "state", "expect": [{"pointer": "/sync/locations/0", "equals": {"name": "This PC", "kind": "local", "state": "synced", "error": null, "progress": null, "stale": false, "removing": false}}, {"pointer": "/sync/locations/1", "equals": {"name": "Ubuntu-24.04", "kind": "wsl", "state": "synced", "error": null, "progress": null, "stale": false, "removing": false}}, {"pointer": "/sync/locations/2", "equals": {"name": "user@macbook", "kind": "ssh", "state": "unreachable", "error": null, "progress": null, "stale": false, "removing": false}}]}
{"cmd": "query", "prefix": "main/sync-failed/", "expect_result": {"pointer": "", "len": 0}}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}
{"cmd": "settle"}

// The sidebar (DESIGN §4.1): the top-level folders in their order, closed, each 32 high in the sidebar's 8px padding, and the three locations 40 high at its foot.
{"cmd": "query", "prefix": "sidebar/folder/", "expect_result": [{"pointer": "", "len": 8}, {"pointer": "/0/target", "equals": "sidebar/folder/dv"}, {"pointer": "/1/target", "equals": "sidebar/folder/fc"}, {"pointer": "/7/target", "equals": "sidebar/folder/Scratch"}]}
{"cmd": "bounds", "target": "sidebar/folder/dv", "expect_result": [{"pointer": "/x", "equals": 8}, {"pointer": "/w", "equals": 231}, {"pointer": "/h", "equals": 32}]}
{"cmd": "query", "prefix": "sidebar/location/", "expect_result": {"pointer": "", "len": 3}}
{"cmd": "bounds", "target": "sidebar/location/This PC", "expect_result": [{"pointer": "/x", "equals": 8}, {"pointer": "/w", "equals": 231}, {"pointer": "/h", "equals": 40}]}
{"cmd": "bounds", "target": "sidebar/location/user@macbook", "expect_result": [{"pointer": "/h", "equals": 40}, {"pointer": "/y", "gte": 850}, {"pointer": "/y", "lte": 852}]}
{"cmd": "screenshot", "name": "all-sessions-dark"}

// fc's page, as E-Folder draws it: 488 sessions with its subfolder's, three path chips, and the cards four to a row under each month's overline.
{"cmd": "click", "target": "sidebar/folder/fc"}
{"cmd": "settle", "expect": [{"pointer": "/library/shelf", "equals": {"folder": "fc"}}, {"pointer": "/library/sessions", "equals": 488}, {"pointer": "/library/folders/1", "equals": {"name": "fc", "parent": null, "sessions": 488}}, {"pointer": "/library/folders/9", "equals": {"name": "player", "parent": "fc", "sessions": 41}}]}
{"cmd": "bounds", "target": "page/header", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "equals": 60}, {"pointer": "/w", "equals": 1144}, {"pointer": "/h", "equals": 72}]}
{"cmd": "bounds", "target": "page/paths", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "equals": 148}, {"pointer": "/h", "equals": 28}]}
{"cmd": "bounds", "target": "card/0", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "equals": 239}, {"pointer": "/w", "equals": 277}, {"pointer": "/h", "equals": 112}]}
{"cmd": "bounds", "target": "card/3", "expect_result": [{"pointer": "/x", "equals": 1139}, {"pointer": "/y", "equals": 239}, {"pointer": "/w", "equals": 277}]}
// October's four cards: 16 under November's, the overline, and 16 more.
{"cmd": "bounds", "target": "card/4", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "equals": 397}]}
{"cmd": "bounds", "target": "page/month", "expect_error": "no target"}
{"cmd": "screenshot", "name": "folder-dark"}

// The chevron opens fc without leaving its page: player's row, one level in.
{"cmd": "click", "target": "sidebar/folder-chevron/fc", "expect": {"pointer": "/library/shelf", "equals": {"folder": "fc"}}}
{"cmd": "query", "prefix": "sidebar/folder/", "expect_result": [{"pointer": "", "len": 9}, {"pointer": "/2/target", "equals": "sidebar/folder/player"}]}
{"cmd": "bounds", "target": "sidebar/folder/player", "expect_result": [{"pointer": "/x", "equals": 8}, {"pointer": "/w", "equals": 231}, {"pointer": "/h", "equals": 32}]}

