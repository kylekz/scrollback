{"scenario": {"window_size": "1440x900", "fixture": "agent", "description": "The first GUI scenario (PLAN §12) up to opening a session: the first run finds an agent's transcripts on this machine, adds the location and syncs it; the sessions appear in Unsorted, grouped by project path; a folder is made from a path, named in the sidebar, and opened; a session is selected, starred and opened. Each state is captured dark and light"}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "settle", "expect": [{"pointer": "/page", "equals": "first-run"}, {"pointer": "/archive/state", "equals": "open"}, {"pointer": "/archive/dir", "contains": "archive"}, {"pointer": "/sync/locations", "equals": []}, {"pointer": "/library/counts/all", "equals": 0}]}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}

// DESIGN §4.10: the title bar has the mark alone; the sidebar's rows are there, with no section buttons and no location.
{"cmd": "bounds", "target": "titlebar/mark", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "titlebar/search", "expect_error": "no target"}
{"cmd": "bounds", "target": "titlebar/sync-all", "expect_error": "no target"}
{"cmd": "bounds", "target": "titlebar/settings", "expect_error": "no target"}
{"cmd": "query", "prefix": "sidebar/", "expect_result": {"pointer": "", "len": 4}}
// The column is 660 wide, centred in the main area (248 to 1440), 56 under the title bar; its title is 22/28.
{"cmd": "bounds", "target": "first-run/title", "expect_result": [{"pointer": "/x", "equals": 514}, {"pointer": "/y", "equals": 96}, {"pointer": "/h", "equals": 28}]}
{"cmd": "bounds", "target": "first-run/this-machine", "expect_result": [{"pointer": "/x", "gte": 514}, {"pointer": "/x", "lte": 515}, {"pointer": "/w", "gte": 658}, {"pointer": "/w", "lte": 660}]}
{"cmd": "bounds", "target": "first-run/add", "expect_result": [{"pointer": "/h", "equals": 28}, {"pointer": "/visible", "not_equals": null}]}
{"cmd": "screenshot", "name": "first-run-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "first-run-light"}
{"cmd": "pin_appearance", "appearance": "dark"}

// Unchecking this machine leaves nothing to add; checking it again brings the button back.
{"cmd": "click", "target": "first-run/this-machine"}
{"cmd": "click", "target": "first-run/add", "expect": {"pointer": "/page", "equals": "first-run"}}
{"cmd": "settle", "expect": {"pointer": "/sync/locations", "equals": []}}
{"cmd": "click", "target": "first-run/this-machine"}

// Adding the location starts its first sync; when it has settled the three sessions are archived, indexed and shown, all in Unsorted.
{"cmd": "click", "target": "first-run/add"}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/sync/syncing", "equals": false}, {"pointer": "/sync/locations", "len": 1}, {"pointer": "/sync/locations/0/kind", "equals": "local"}, {"pointer": "/sync/locations/0/state", "equals": "synced"}, {"pointer": "/library/shelf", "equals": "all"}, {"pointer": "/library/counts", "equals": {"all": 3, "starred": 0, "unsorted": 3, "trash": 0}}, {"pointer": "/library/sessions", "equals": 3}, {"pointer": "/library/folders", "equals": []}]}
{"cmd": "bounds", "target": "titlebar/search", "expect_result": [{"pointer": "/x", "equals": 490}, {"pointer": "/w", "equals": 460}]}
{"cmd": "bounds", "target": "titlebar/sync-all", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "query", "prefix": "sidebar/location/", "expect_result": {"pointer": "", "len": 1}}
// DESIGN §2, §4.4: the page has 20px above its header and 24px at its sides; the filter row (28) and 16 under it; cards are a quarter of the row less the 12px gap, 112 high, under the month's overline.
// Where a position or a size below is a range, its upper end is the design's number: a fractional display scale (125%, 150%, 175%) rounds each 1px hairline and gap above a thing to whole device pixels, which takes a pixel or two off where it sits and sometimes one off its height. The ranges are what Windows reports at 100%, 125%, 150% and 175%.
{"cmd": "bounds", "target": "page/header", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "equals": 60}, {"pointer": "/w", "equals": 1144}, {"pointer": "/h", "gte": 71}, {"pointer": "/h", "lte": 72}]}
{"cmd": "bounds", "target": "card/0", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "gte": 219}, {"pointer": "/y", "lte": 222}, {"pointer": "/w", "equals": 277}, {"pointer": "/h", "equals": 112}]}
{"cmd": "bounds", "target": "card/1", "expect_result": [{"pointer": "/x", "equals": 561}, {"pointer": "/y", "gte": 219}, {"pointer": "/y", "lte": 222}, {"pointer": "/w", "equals": 277}]}
// October's card is alone on its row and as wide as the others.
{"cmd": "bounds", "target": "card/2", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "gte": 377}, {"pointer": "/y", "lte": 380}, {"pointer": "/w", "equals": 277}]}
{"cmd": "screenshot", "name": "all-sessions-dark"}

// Unsorted groups them by where they started: the path with two sessions first.
{"cmd": "click", "target": "sidebar/unsorted"}
{"cmd": "settle", "expect": [{"pointer": "/page", "equals": "unsorted"}, {"pointer": "/library/shelf", "equals": "unsorted"}, {"pointer": "/library/groups", "equals": 2}]}
// DESIGN §4.6: a group's head is 44 high under its section's border and its rows 34; the next group starts 12 under the last row.
{"cmd": "bounds", "target": "unsorted/group/0", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/y", "gte": 185}, {"pointer": "/y", "lte": 188}, {"pointer": "/w", "equals": 1144}, {"pointer": "/h", "gte": 44}, {"pointer": "/h", "lte": 45}]}
{"cmd": "bounds", "target": "unsorted/row/0/0", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/w", "equals": 1144}, {"pointer": "/h", "gte": 33}, {"pointer": "/h", "lte": 34}]}
{"cmd": "bounds", "target": "unsorted/group/1", "expect_result": [{"pointer": "/y", "gte": 310}, {"pointer": "/y", "lte": 313}, {"pointer": "/h", "gte": 44}, {"pointer": "/h", "lte": 46}]}
{"cmd": "screenshot", "name": "unsorted-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "unsorted-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
// A group closes and opens at its head.
{"cmd": "click", "target": "unsorted/group/0/toggle"}
{"cmd": "bounds", "target": "unsorted/group/0", "expect_result": [{"pointer": "/h", "gte": 44}, {"pointer": "/h", "lte": 45}]}
{"cmd": "bounds", "target": "unsorted/row/0/0", "expect_error": "no target"}
{"cmd": "bounds", "target": "unsorted/group/1", "expect_result": [{"pointer": "/y", "gte": 242}, {"pointer": "/y", "lte": 245}]}
{"cmd": "click", "target": "unsorted/group/0/toggle"}
{"cmd": "bounds", "target": "unsorted/row/0/1", "expect_result": {"pointer": "/visible", "not_equals": null}}

// Create folder from this path (DESIGN §4.6): a folder named after the path's last component, with the path attached, which files the group; it is renamed in its row.
{"cmd": "click", "target": "unsorted/group/0/create-folder"}
{"cmd": "settle", "expect": [{"pointer": "/library/folders", "equals": [{"name": "app", "parent": null, "sessions": 2}]}, {"pointer": "/library/counts/unsorted", "equals": 1}, {"pointer": "/library/groups", "equals": 1}, {"pointer": "/page", "equals": "unsorted"}]}
{"cmd": "bounds", "target": "sidebar/folder-rename", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "folder-rename-dark"}
// The name is selected, so typing replaces it, and Enter keeps what was typed.
{"cmd": "type", "text": "uploads\n"}
{"cmd": "settle", "expect": {"pointer": "/library/folders/0/name", "equals": "uploads"}}
{"cmd": "bounds", "target": "sidebar/folder-rename", "expect_error": "no target"}

// The folder's page: its path as a chip, and the two sessions it filed.
{"cmd": "click", "target": "sidebar/folder/uploads"}
{"cmd": "settle", "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/library/shelf", "equals": {"folder": "uploads"}}, {"pointer": "/library/sessions", "equals": 2}, {"pointer": "/library/selected", "equals": null}]}
{"cmd": "bounds", "target": "sidebar/folder/uploads", "expect_result": [{"pointer": "/x", "equals": 8}, {"pointer": "/w", "equals": 231}, {"pointer": "/h", "equals": 32}]}
{"cmd": "bounds", "target": "page/paths", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/h", "equals": 28}]}
{"cmd": "bounds", "target": "card/0", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/w", "equals": 277}, {"pointer": "/h", "equals": 112}]}
{"cmd": "screenshot", "name": "folder-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "folder-light"}
{"cmd": "pin_appearance", "appearance": "dark"}

// A click selects a card, S stars it, and Enter opens it: the page that names the session until the reader is built.
{"cmd": "click", "target": "card/1", "expect": {"pointer": "/library/selected", "equals": "Add retries to the fetcher"}}
{"cmd": "key", "keystroke": "left", "expect": {"pointer": "/library/selected", "equals": "Fix the flaky upload test"}}
{"cmd": "key", "keystroke": "s"}
{"cmd": "settle", "expect": {"pointer": "/library/counts/starred", "equals": 1}}
{"cmd": "screenshot", "name": "folder-selected-dark"}
{"cmd": "key", "keystroke": "enter", "expect": [{"pointer": "/page", "equals": "session"}, {"pointer": "/library/open", "equals": "Fix the flaky upload test"}]}
{"cmd": "bounds", "target": "session/title", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "session-dark"}
{"cmd": "click", "target": "session/back", "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/library/open", "equals": null}, {"pointer": "/library/selected", "equals": "Fix the flaky upload test"}]}
// The title opens it too, and Alt Left goes back.
{"cmd": "click", "target": "card/1/title", "expect": {"pointer": "/library/open", "equals": "Add retries to the fetcher"}}
{"cmd": "key", "keystroke": "alt-left", "expect": {"pointer": "/page", "equals": "sessions"}}

// Starred lists the starred session; its star, on the card under the pointer, takes it off again.
{"cmd": "click", "target": "sidebar/starred"}
{"cmd": "settle", "expect": [{"pointer": "/library/shelf", "equals": "starred"}, {"pointer": "/library/sessions", "equals": 1}]}
{"cmd": "click", "target": "card/0/star"}
{"cmd": "settle", "expect": [{"pointer": "/library/counts/starred", "equals": 0}, {"pointer": "/library/sessions", "equals": 0}]}
{"cmd": "bounds", "target": "page/empty", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "starred-empty-dark"}

// New folder (Ctrl Shift N) makes one at the top and names it in its row; its page is the empty folder (DESIGN §4.4).
{"cmd": "key", "keystroke": "secondary-shift-n"}
{"cmd": "settle", "expect": {"pointer": "/library/folders", "len": 2}}
{"cmd": "type", "text": "blog\n"}
{"cmd": "settle", "expect": {"pointer": "/library/folders/1", "equals": {"name": "blog", "parent": null, "sessions": 0}}}
{"cmd": "click", "target": "sidebar/folder/blog"}
{"cmd": "settle", "expect": [{"pointer": "/library/shelf", "equals": {"folder": "blog"}}, {"pointer": "/library/sessions", "equals": 0}]}
{"cmd": "bounds", "target": "page/empty", "expect_result": [{"pointer": "/x", "equals": 272}, {"pointer": "/w", "equals": 1144}]}
{"cmd": "screenshot", "name": "empty-folder-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "empty-folder-light"}
{"cmd": "pin_appearance", "appearance": "dark"}

// Sync all (F5) syncs every location again; nothing changed at the source, so the library is as it was.
{"cmd": "key", "keystroke": "f5"}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/sync/locations/0/state", "equals": "synced"}, {"pointer": "/library/counts", "equals": {"all": 3, "starred": 0, "unsorted": 1, "trash": 0}}]}

// A restart opens the same archive: no first run, the folders and their sessions as they were.
{"restart": {}, "expect": {"pointer": "/archive/state", "not_equals": "failed"}}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/library/counts", "equals": {"all": 3, "starred": 0, "unsorted": 1, "trash": 0}}, {"pointer": "/library/folders/0", "equals": {"name": "uploads", "parent": null, "sessions": 2}}, {"pointer": "/sync/locations", "len": 1}]}
