{"scenario": {"window_size": "1440x900", "fixture": "reader-versions", "description": "Versions (DESIGN §4.3) on E-Versions' session, whose third version is held back: the held back chip on its card and its list row, the facts' Version, History with the held back, reading copy and viewing states, an older version read with its banner and the facts' 'older', back to the reading copy, and a version made the reading copy; dark and light at 1440x900 and 960x600"}}
{"cmd": "wait_ready", "timeout_ms": 60000}
{"cmd": "settle", "timeout_ms": 60000, "expect": {"pointer": "/library/counts/all", "equals": 9}}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}

// The held back chip on the card, found without opening it.
{"cmd": "click", "target": "sidebar/folder/toolbox-rs"}
{"cmd": "settle", "expect": {"pointer": "/library/sessions", "equals": 2}}
{"cmd": "screenshot", "name": "versions-card-1440-dark"}
{"cmd": "click", "target": "card/1/title"}
{"cmd": "settle", "expect": [{"pointer": "/library/open", "equals": "Word-level marks in dv's diff"}, {"pointer": "/reader/viewing", "equals": null}]}
{"cmd": "bounds", "target": "reader/facts/version", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "versions-reading-copy-1440-dark"}

// History: v3 held back with Read and Make, v2 the reading copy, v1 extended by a sync.
{"cmd": "click", "target": "reader/facts/history"}
{"cmd": "settle", "expect": {"pointer": "/reader/history", "not_equals": null}}
{"cmd": "bounds", "target": "reader/history", "expect_result": {"pointer": "/w", "gte": 439, "lte": 441}}
{"cmd": "bounds", "target": "reader/history/make/3", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "versions-history-1440-dark"}

// Read v1: the banner across the column, the facts' Version reads older, History marks it viewing.
{"cmd": "click", "target": "reader/history/read/1"}
{"cmd": "settle", "expect": [{"pointer": "/reader/viewing", "equals": 1}, {"pointer": "/reader/history", "equals": null}]}
{"cmd": "bounds", "target": "reader/older", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "versions-older-1440-dark"}
{"cmd": "click", "target": "reader/facts/history"}
{"cmd": "settle"}
{"cmd": "bounds", "target": "reader/history/make/1", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "versions-history-viewing-1440-dark"}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "settle", "expect": {"pointer": "/reader/history", "equals": null}}

// Light, and narrow: the banner wraps; the facts are behind the toggle.
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "versions-older-1440-light"}
{"cmd": "resize", "w": 960, "h": 600, "expect": {"pointer": "/shell/sidebar", "equals": "collapsed"}}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "versions-older-960-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "versions-older-960-dark"}
{"cmd": "resize", "w": 1440, "h": 900}
{"cmd": "settle"}

// Back to the reading copy.
{"cmd": "click", "target": "reader/older/back"}
{"cmd": "settle", "expect": {"pointer": "/reader/viewing", "equals": null}}

// Make v3 the reading copy: accepted, no longer held back, and the card's chip goes.
{"cmd": "click", "target": "reader/facts/history"}
{"cmd": "settle"}
{"cmd": "click", "target": "reader/history/make/3"}
{"cmd": "settle", "expect": [{"pointer": "/reader/viewing", "equals": null}, {"pointer": "/reader/history", "equals": null}]}
{"cmd": "screenshot", "name": "versions-made-copy-1440-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "click", "target": "reader/facts/history"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "versions-history-after-1440-light"}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "key", "keystroke": "alt-left"}
{"cmd": "settle", "expect": {"pointer": "/page", "equals": "sessions"}}
{"cmd": "screenshot", "name": "versions-card-after-1440-light"}
