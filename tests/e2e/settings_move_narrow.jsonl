{"scenario": {"window_size": "960x600", "fixture": "settings", "description": "Move… (DESIGN §4.13) in the smallest window (DESIGN §2): the folder card's three buttons wrap rather than clip, the question fits, and the move's progress with Stop, then where the old folder is, captured dark and light"}}
{"cmd": "wait_ready", "timeout_ms": 30000}
{"cmd": "settle", "timeout_ms": 30000, "expect": [{"pointer": "/page", "equals": "sessions"}, {"pointer": "/shell/sidebar", "equals": "collapsed"}, {"pointer": "/sync/syncing", "equals": false}]}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}
{"cmd": "key", "keystroke": "secondary-,"}
{"cmd": "settle", "expect": {"pointer": "/page", "equals": "settings"}}
{"cmd": "bounds", "target": "settings/archive/move", "expect_result": [{"pointer": "/visible", "not_equals": null}, {"pointer": "/x", "gte": 232}]}

{"cmd": "answer_picker", "folder": "${out_dir}/moved-archive"}
{"cmd": "click", "target": "settings/archive/move"}
{"cmd": "settle", "expect": {"pointer": "/settings/move/state", "equals": "asking"}}
{"cmd": "bounds", "target": "settings/move-confirm/ok", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "confirm-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "confirm-light"}
{"cmd": "pin_appearance", "appearance": "dark"}

{"cmd": "hold_move", "after": 2}
{"cmd": "click", "target": "settings/move-confirm/ok"}
{"cmd": "wait_for", "pointer": "/settings/move_held", "equals": true, "timeout_ms": 30000}
{"cmd": "wait_for", "pointer": "/settings/move/files_done", "equals": 2, "timeout_ms": 10000}
{"cmd": "bounds", "target": "settings/move/stop", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "moving-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "wait_frames", "n": 3}
{"cmd": "screenshot", "name": "moving-light"}
{"cmd": "pin_appearance", "appearance": "dark"}

{"cmd": "release_move"}
{"cmd": "settle", "timeout_ms": 60000, "expect": [{"pointer": "/settings/move", "equals": null}, {"pointer": "/page", "equals": "settings"}, {"pointer": "/settings/archive", "contains": "moved-archive"}, {"pointer": "/settings/verify/running", "equals": false}]}
{"cmd": "bounds", "target": "settings/moved/reveal", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "moved-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "moved-light"}
