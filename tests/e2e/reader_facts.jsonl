{"scenario": {"window_size": "1440x900", "fixture": "reader-facts", "description": "The facts margin (DESIGN §4.2.8) on a session whose facts are as long as they come: a 200-character path and a long branch cut in their middle, whole on hover and copied whole, When on two lines, four models one a line; the memory files it loaded on its way (§4.2.11), one opened to its text; dark at 1440x900, the facts over the column at 960x600 in dark and light, and at 150% on Windows"}}
{"cmd": "wait_ready", "timeout_ms": 60000}
{"cmd": "settle", "timeout_ms": 60000, "expect": {"pointer": "/library/counts/all", "equals": 9}}
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}
{"cmd": "click", "target": "sidebar/folder/fc"}
{"cmd": "settle", "expect": {"pointer": "/library/sessions", "equals": 6}}

// The session ran longest ago, so it is fc's last card.
{"cmd": "click", "target": "card/5/title"}
{"cmd": "settle", "expect": [{"pointer": "/library/open", "equals": "Reader fixture: facts as long as they come"}, {"pointer": "/reader/state", "equals": "open"}, {"pointer": "/reader/facts", "equals": true}]}

// Each fact is its label over its value, inside the margin's 16 padding: a value is one line of 16 under a label of 14 (Path and Branch with a border for the keyboard's ring), When two lines, the models four.
{"cmd": "bounds", "target": "reader/facts", "expect_result": [{"pointer": "/w", "gte": 267, "lte": 269}]}
{"cmd": "bounds", "target": "reader/facts/path", "expect_result": [{"pointer": "/x", "gte": 1187, "lte": 1191}, {"pointer": "/w", "gte": 233, "lte": 237}, {"pointer": "/h", "gte": 33, "lte": 35}]}
{"cmd": "bounds", "target": "reader/facts/path/value", "expect_result": [{"pointer": "/w", "lte": 237}, {"pointer": "/h", "gte": 17, "lte": 19}]}
{"cmd": "bounds", "target": "reader/facts/branch", "expect_result": [{"pointer": "/w", "lte": 237}, {"pointer": "/h", "gte": 33, "lte": 35}]}
{"cmd": "bounds", "target": "reader/facts/when", "expect_result": [{"pointer": "/w", "lte": 237}, {"pointer": "/h", "gte": 47, "lte": 49}]}
{"cmd": "bounds", "target": "reader/facts/tokens", "expect_result": [{"pointer": "/w", "lte": 237}, {"pointer": "/h", "gte": 31, "lte": 33}]}
{"cmd": "bounds", "target": "reader/facts/models", "expect_result": [{"pointer": "/w", "lte": 237}, {"pointer": "/h", "gte": 79, "lte": 81}]}
{"cmd": "screenshot", "name": "facts-long-1440-dark"}

// The path whole on hover; a click copies it whole, and the branch too.
{"cmd": "mouse_move", "target": "reader/facts/path/value"}
{"cmd": "wait", "ms": 900}
{"cmd": "screenshot", "name": "facts-path-hover-1440-dark"}
{"cmd": "click", "target": "reader/facts/path/value"}
{"cmd": "settle", "expect": {"pointer": "/system", "contains": {"kind": "copy", "text": "/home/user/code/fc/crates/fc_downloads/src/importers/playlists/regression-fixtures/a-folder-name-long-enough-to-overflow-the-facts-margin/and-one-more-after-it/until-the-whole-path-is-two-hundred-long"}}}
{"cmd": "bounds", "target": "reader/facts/path/copied", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "facts-path-copied-1440-dark"}
{"cmd": "click", "target": "reader/facts/branch/value"}
{"cmd": "settle", "expect": {"pointer": "/system", "contains": {"kind": "copy", "text": "feature/playlist-import-keeps-the-order-of-tracks-across-pages-and-retries"}}}

// The memory files it loaded: one quiet line each, the second's text no longer the file's on disk; the first opened to its text as Markdown.
{"cmd": "bounds", "target": "reader/context-file/main/2", "expect_result": [{"pointer": "/visible", "not_equals": null}, {"pointer": "/h", "gte": 21, "lte": 23}]}
{"cmd": "bounds", "target": "reader/context-file/main/4", "expect_result": [{"pointer": "/visible", "not_equals": null}, {"pointer": "/h", "gte": 21, "lte": 23}]}
{"cmd": "click", "target": "reader/context-file/main/2"}
{"cmd": "settle", "expect": {"pointer": "/reader/open_calls", "equals": 0}}
{"cmd": "bounds", "target": "reader/prose/main/2", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "screenshot", "name": "context-file-open-1440-dark"}

// 960x600: the facts over the column keep each value on its line.
{"cmd": "resize", "w": 960, "h": 600, "expect": {"pointer": "/shell/sidebar", "equals": "collapsed"}}
{"cmd": "settle", "expect": {"pointer": "/reader/facts", "equals": false}}
{"cmd": "click", "target": "reader/facts-toggle"}
{"cmd": "settle", "expect": {"pointer": "/reader/facts", "equals": true}}
{"cmd": "bounds", "target": "reader/facts/path", "expect_result": [{"pointer": "/x", "gte": 707, "lte": 711}, {"pointer": "/w", "gte": 233, "lte": 237}, {"pointer": "/h", "gte": 33, "lte": 35}]}
{"cmd": "bounds", "target": "reader/facts/when", "expect_result": {"pointer": "/h", "gte": 47, "lte": 49}}
{"cmd": "screenshot", "name": "facts-long-overlay-960-dark"}
{"cmd": "pin_appearance", "appearance": "light"}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "facts-long-overlay-960-light"}
{"cmd": "pin_appearance", "appearance": "dark"}
{"cmd": "key", "keystroke": "escape"}
{"cmd": "settle", "expect": {"pointer": "/reader/facts", "equals": false}}

