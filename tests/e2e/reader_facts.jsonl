{"cmd": "resize", "w": 1440, "h": 900, "platforms": ["windows"]}
{"cmd": "dpi_changed", "dpi": 144, "platforms": ["windows"], "expect_result": {"pointer": "/scale", "equals": 1.5}}
{"cmd": "settle", "platforms": ["windows"], "expect": {"pointer": "/reader/facts", "equals": true}}
{"cmd": "bounds", "target": "reader/facts/path", "platforms": ["windows"], "expect_result": [{"pointer": "/w", "gte": 233, "lte": 237}, {"pointer": "/h", "gte": 33, "lte": 35}]}
{"cmd": "bounds", "target": "reader/facts/when", "platforms": ["windows"], "expect_result": {"pointer": "/h", "gte": 47, "lte": 49}}
{"cmd": "screenshot", "name": "facts-long-1440-dark-150", "platforms": ["windows"]}
{"cmd": "resize", "w": 960, "h": 600, "platforms": ["windows"]}
{"cmd": "settle", "platforms": ["windows"]}
{"cmd": "click", "target": "reader/facts-toggle", "platforms": ["windows"]}
{"cmd": "settle", "platforms": ["windows"], "expect": {"pointer": "/reader/facts", "equals": true}}
{"cmd": "screenshot", "name": "facts-long-overlay-960-dark-150", "platforms": ["windows"]}
