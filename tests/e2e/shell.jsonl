{"scenario": {"window_size": "1440x900", "description": "The empty concept E shell (DESIGN §2, §4.1): its regions sit where DESIGN puts them, it is captured dark and light on the Opaque surfaces the boards draw, a narrow window collapses the sidebar, and --window-size and --theme do what they say"}}
{"cmd": "wait_ready", "timeout_ms": 20000}
{"cmd": "settle"}
{"cmd": "state", "expect": [{"pointer": "/app", "equals": "scrollback"}, {"pointer": "/data_dir", "equals": "${data_dir}"}, {"pointer": "/window/w", "equals": 1440}, {"pointer": "/window/h", "equals": 900}, {"pointer": "/shell/sidebar", "equals": "docked"}, {"pointer": "/appearance/mode", "equals": "system"}, {"pointer": "/appearance/pinned", "equals": null}]}

// DESIGN §1.4, §2: title bar 40, sidebar 248, the main area takes the rest.
{"cmd": "bounds", "target": "titlebar", "expect_result": [{"pointer": "/x", "equals": 0}, {"pointer": "/y", "equals": 0}, {"pointer": "/w", "equals": 1440}, {"pointer": "/h", "equals": 40}, {"pointer": "/count", "equals": 1}]}
{"cmd": "bounds", "target": "shell/sidebar", "expect_result": [{"pointer": "/x", "equals": 0}, {"pointer": "/y", "equals": 40}, {"pointer": "/w", "equals": 248}, {"pointer": "/h", "equals": 860}]}
{"cmd": "bounds", "target": "shell/main", "expect_result": [{"pointer": "/x", "equals": 248}, {"pointer": "/y", "equals": 40}, {"pointer": "/w", "equals": 1192}, {"pointer": "/h", "equals": 860}]}

// The title bar's pieces: the search field is 460 wide, centred on the window (DESIGN §2).
{"cmd": "bounds", "target": "titlebar/search", "expect_result": [{"pointer": "/x", "equals": 490}, {"pointer": "/w", "equals": 460}, {"pointer": "/h", "equals": 30}, {"pointer": "/visible", "not_equals": null}]}
{"cmd": "bounds", "target": "titlebar/mark", "expect_result": {"pointer": "/visible", "not_equals": null}}
{"cmd": "bounds", "target": "titlebar/sync-all", "expect_result": [{"pointer": "/h", "equals": 24}, {"pointer": "/visible", "not_equals": null}]}
{"cmd": "bounds", "target": "titlebar/settings", "expect_result": [{"pointer": "/w", "equals": 28}, {"pointer": "/h", "equals": 28}, {"pointer": "/visible", "not_equals": null}]}
// The sidebar's button shows only while the window is too narrow to dock the sidebar.
{"cmd": "bounds", "target": "titlebar/sidebar", "expect_error": "no target"}
// Windows' caption buttons: 46 wide, the title bar's height inside its bottom hairline (one device pixel), flush right; macOS draws traffic lights instead.
{"cmd": "bounds", "target": "titlebar/close", "platforms": ["windows"], "expect_result": [{"pointer": "/x", "equals": 1394}, {"pointer": "/y", "equals": 0}, {"pointer": "/w", "equals": 46}, {"pointer": "/h", "gte": 39}, {"pointer": "/h", "lte": 40}]}
{"cmd": "bounds", "target": "titlebar/max", "platforms": ["windows"], "expect_result": [{"pointer": "/x", "equals": 1348}, {"pointer": "/w", "equals": 46}]}
{"cmd": "bounds", "target": "titlebar/min", "platforms": ["windows"], "expect_result": [{"pointer": "/x", "equals": 1302}, {"pointer": "/w", "equals": 46}]}
{"cmd": "bounds", "target": "titlebar/close", "platforms": ["macos"], "expect_error": "no target"}

// The sidebar's empty state (DESIGN §4.1, §4.10): four library rows 32 high inside its 8px padding and 1px right border, then the section buttons.
{"cmd": "query", "prefix": "sidebar/", "expect_result": {"pointer": "", "len": 6}}
{"cmd": "bounds", "target": "sidebar/all-sessions", "expect_result": [{"pointer": "/x", "equals": 8}, {"pointer": "/y", "equals": 50}, {"pointer": "/w", "equals": 231}, {"pointer": "/h", "equals": 32}]}
{"cmd": "bounds", "target": "sidebar/trash", "expect_result": [{"pointer": "/y", "equals": 149}, {"pointer": "/h", "equals": 32}]}
{"cmd": "bounds", "target": "sidebar/new-folder", "expect_result": [{"pointer": "/w", "equals": 22}, {"pointer": "/h", "equals": 22}]}
{"cmd": "bounds", "target": "sidebar/sync-all", "expect_result": [{"pointer": "/w", "equals": 22}, {"pointer": "/h", "equals": 22}]}

// Dark and light, pinned so the captures don't depend on the machine's own setting, on the Opaque surfaces the boards draw.
{"cmd": "set_appearance", "material": "opaque", "expect_result": {"pointer": "/resolved/material", "equals": "opaque"}}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": [{"pointer": "/pinned", "equals": "dark"}, {"pointer": "/resolved/appearance", "equals": "dark"}]}
{"cmd": "settle", "expect": {"pointer": "/shell/window_material", "equals": "opaque"}}
{"cmd": "screenshot", "name": "shell-dark"}
{"cmd": "pin_appearance", "appearance": "light", "expect_result": [{"pointer": "/pinned", "equals": "light"}, {"pointer": "/resolved/appearance", "equals": "light"}]}
{"cmd": "settle"}
{"cmd": "screenshot", "name": "shell-light"}
{"cmd": "pin_appearance", "appearance": "dark", "expect_result": {"pointer": "/resolved/appearance", "equals": "dark"}}

// Below 1040 the sidebar collapses and its button appears left of the mark (DESIGN §2).
{"cmd": "resize", "w": 960, "h": 600, "expect": {"pointer": "/shell/sidebar", "equals": "collapsed"}}
{"cmd": "bounds", "target": "shell/sidebar", "expect_error": "no target"}
{"cmd": "bounds", "target": "shell/main", "expect_result": [{"pointer": "/x", "equals": 0}, {"pointer": "/w", "equals": 960}, {"pointer": "/h", "equals": 560}]}
{"cmd": "bounds", "target": "titlebar/search", "platforms": ["macos"], "expect_result": [{"pointer": "/x", "equals": 250}, {"pointer": "/w", "equals": 460}]}
// The caption buttons need more than half of what the field leaves, so the field moves left of centre.
{"cmd": "bounds", "target": "titlebar/search", "platforms": ["windows"], "expect_result": [{"pointer": "/x", "lte": 250}, {"pointer": "/x", "gte": 160}, {"pointer": "/w", "equals": 460}]}
{"cmd": "screenshot", "name": "shell-960x600"}
// The button and Ctrl B show it over the main area; Esc and a click outside close it.
{"cmd": "click", "target": "titlebar/sidebar", "expect": {"pointer": "/shell/sidebar", "equals": "overlay"}}
{"cmd": "bounds", "target": "shell/sidebar", "expect_result": [{"pointer": "/x", "equals": 0}, {"pointer": "/y", "equals": 40}, {"pointer": "/w", "equals": 248}, {"pointer": "/h", "equals": 560}]}
{"cmd": "bounds", "target": "shell/main", "expect_result": {"pointer": "/w", "equals": 960}}
{"cmd": "screenshot", "name": "shell-960x600-sidebar"}
{"cmd": "key", "keystroke": "escape", "expect": {"pointer": "/shell/sidebar", "equals": "collapsed"}}
{"cmd": "key", "keystroke": "secondary-b", "expect": {"pointer": "/shell/sidebar", "equals": "overlay"}}
{"cmd": "click", "x": 600, "y": 300, "expect": {"pointer": "/shell/sidebar", "equals": "collapsed"}}
{"cmd": "click", "target": "titlebar/sidebar", "expect": {"pointer": "/shell/sidebar", "equals": "overlay"}}
{"cmd": "click", "target": "titlebar/sidebar", "expect": {"pointer": "/shell/sidebar", "equals": "collapsed"}}

// A smaller --window-size is raised to the minimum (DESIGN §2: 960x600).
{"restart": {"app_args": ["--window-size", "800x500"]}, "expect": [{"pointer": "/window/w", "equals": 960}, {"pointer": "/window/h", "equals": 600}, {"pointer": "/appearance/pinned", "equals": null}]}
// --theme forces light or dark for the run without a pin.
{"restart": {"app_args": ["--theme", "light"]}, "expect": [{"pointer": "/window/w", "equals": 1440}, {"pointer": "/appearance/mode", "equals": "light"}, {"pointer": "/appearance/pinned", "equals": null}, {"pointer": "/appearance/resolved/appearance", "equals": "light"}]}
{"restart": {"app_args": ["--theme", "dark"]}, "expect": [{"pointer": "/appearance/mode", "equals": "dark"}, {"pointer": "/appearance/resolved/appearance", "equals": "dark"}]}
